{
    "name": "jdz/pdfbuilder",
    "type": "library",
    "description": "Build a PDF with TCPDF and FPDI",
    "keywords": [
        "JDZ",
        "utilities",
        "pdf",
        "services"
    ],
    "homepage": "https://jdz.joffreydemetz.com/pdfbuilder",
    "license": "MIT",
    "authors": [
        {
            "name": "Joffrey Demetz",
            "email": "joffrey.demetz@gmail.com",
            "homepage": "https://joffreydemetz.com",
            "role": "Lead"
        }
    ],
    "require": {
        "php": ">=8.2",
        "tecnickcom/tcpdf": "^6.3",
        "setasign/fpdi": "^2.6",
        "symfony/yaml": "^7.4",
        "jdz/data": "^2.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "JDZ\\Pdf\\": "src"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "JDZ\\Pdf\\Tests\\": "tests"
        }
    }
}
